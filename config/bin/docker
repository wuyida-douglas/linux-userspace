#!/usr/bin/env python3
"""Refresh the existing user's docker group in an old IDE login session."""
import os
import shlex
import subprocess
import sys

# Callers may supply either the conventional full ["docker", ...] argv or
# this wrapper's implicit-docker shorthand. Normalize once for both paths.
argv = sys.argv[1:]
if argv and argv[0] == "docker":
    argv = argv[1:]

if "docker" not in subprocess.run(["id", "-nG"], capture_output=True, text=True,
                                  check=True).stdout.split():
    # newgrp reads a command from the invoking shell, not from argv. Feed it
    # exactly one exec command through a pipe while retaining stdout/stderr
    # and the caller's process group for bounded cleanup. Plain `sg docker -c`
    # detaches children into a separate session and defeats timeout cleanup.
    read_fd, write_fd = os.pipe()
    # Run a fresh shell explicitly to preserve quoting in Docker arguments.
    command = "exec /bin/bash -c " + shlex.quote("exec /usr/bin/docker " + shlex.join(argv)) + "\n"
    os.write(write_fd, command.encode())
    os.close(write_fd)
    os.dup2(read_fd, 0)
    os.close(read_fd)
    os.execvp("newgrp", ["newgrp", "docker"])
os.execv("/usr/bin/docker", ["/usr/bin/docker", *argv])
